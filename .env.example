# =============================================================================
# MedVision AI — Environment Variables
# cp .env.example .env  →  fill in secrets  →  NEVER commit .env
# =============================================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
POSTGRES_USER=medvision
POSTGRES_PASSWORD=medvision
POSTGRES_DB=medvision

# ---------------------------------------------------------------------------
# Redis / Celery
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------------------------------------------------------------------
# Authentication (JWT)
# ---------------------------------------------------------------------------
# Generate: openssl rand -hex 32
JWT_SECRET_KEY=dev-insecure-change-me-before-any-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Long-lived, DB-backed refresh tokens (rotated on use, revoked on logout)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Single-use password-reset token lifetime
PASSWORD_RESET_EXPIRE_MINUTES=30

# Seeded admin account (created on first startup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Inference backend
# ---------------------------------------------------------------------------
# onnx   = local ONNX Runtime on CPU (default; no GPU/Triton needed)  -> make up
# triton = NVIDIA Triton Inference Server on GPU                      -> make up-gpu
INFERENCE_BACKEND=onnx
MODEL_REPO_ROOT=/models

# ---------------------------------------------------------------------------
# Triton Inference Server  (used only with the GPU variant / --profile triton)
# ---------------------------------------------------------------------------
TRITON_HTTP_URL=triton:8000
TRITON_GRPC_URL=triton:8001

# ---------------------------------------------------------------------------
# Report Service — local LLM via Ollama (on-prem, no external API)
# ---------------------------------------------------------------------------
OLLAMA_URL=http://ollama:11434
# Default: OpenBioLLM-8B (Q8_0 GGUF, ~10 GB VRAM, fits a 16 GB GPU). Verify the
# exact HF repo/tag, or override — e.g. a tiny model for CPU/dev/CI:
#   LLM_MODEL_NAME=qwen2.5:0.5b
LLM_MODEL_NAME=hf.co/mradermacher/Llama3-OpenBioLLM-8B-GGUF:Q8_0
LLM_MAX_NEW_TOKENS=512

# ---------------------------------------------------------------------------
# Observability  (used only with --profile monitoring)
# ---------------------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
# Distributed tracing — enable with `make up-monitoring` (Jaeger OTLP HTTP :4318)
OTEL_TRACES_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
DOCS_ENABLED=true
